{
  "uid": "trading-invariants",
  "title": "Trading Engine — Invariants & RED",
  "description": "Correctness first: invariant gauges pinned at zero are the whole story during a chaos demo (ARCHITECTURE.md §12). RED metrics and business counters follow below for saturation and throughput context.",
  "tags": ["trading-system", "invariants"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Invariants — must all read zero / OK",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Invariants OK",
      "description": "trading_invariants_ok. 1 = every invariant check passed on the last pass, 0 = at least one is violated.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "trading_invariants_ok",
          "legendFormat": "invariants_ok",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "VIOLATION", "color": "red", "index": 0 },
                "1": { "text": "OK", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total invariant violations",
      "description": "sum(trading_invariant_violations) across every check label (unbalanced_txns, orphaned_fill_halves, unpaired_clearing_units, cash_conservation_delta, position_ledger_mismatch, balance_ledger_mismatch, negative_cash_accounts, overdrawn_reservations). Must be zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(trading_invariant_violations)",
          "legendFormat": "violations",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst reservation overdraw",
      "description": "trading_reservation_worst_overdraw_minor. Above zero means a fill cost more than was reserved for it at accept time — a violation of the no-negative-cash argument (ARCHITECTURE.md §4.2). Minor currency units (e.g. cents).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "trading_reservation_worst_overdraw_minor",
          "legendFormat": "worst_overdraw_minor",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Share conservation delta (worst symbol)",
      "description": "max(abs(trading_share_conservation_delta)) over all symbols. Per symbol: shares held across all accounts minus shares issued. Must be zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "max(abs(trading_share_conservation_delta))",
          "legendFormat": "worst_share_delta",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1e-9 }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Saturation & recovery — informational, not faults",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Fill halves in flight",
      "description": "trading_fill_halves_in_flight. A fill is two transactions in two partitions with no transaction spanning them, so halves in flight are the NORMAL state of a busy system, not breakage. Rising trend = backpressure, not a violation. Deliberately colored blue, not red/green.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "trading_fill_halves_in_flight",
          "legendFormat": "in_flight",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Snapshot max tail",
      "description": "trading_snapshot_max_tail. Worst-case number of transactions any account must replay past its latest snapshot — what snapshots exist to bound (ARCHITECTURE.md §9).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 9 },
      "targets": [
        {
          "expr": "trading_snapshot_max_tail",
          "legendFormat": "max_tail",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Snapshots retained",
      "description": "trading_snapshots. Snapshot rows retained.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "trading_snapshots",
          "legendFormat": "snapshots",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "text",
      "title": "Outbox / consumer health",
      "description": "Placeholder — not wired to a real metric yet.",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "options": {
        "mode": "markdown",
        "content": "**Not yet exposed.**\n\nARCHITECTURE.md §12 specifies `outbox_relay_lag_seconds` and consumer lag per topic/partition as load-bearing for correctness (gates §5.2's dedup window). `internal/metrics/metrics.go` does not register these collectors yet — they belong to the outbox relay / Kafka consumer, which is Part 2 (§14b) surface, not the Part 1 engine this dashboard was built against.\n\nWire a panel here (e.g. `max(outbox_relay_lag_seconds)`, `sum(kafka_consumer_lag) by (topic, partition)`) once those collectors exist."
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "RED — request rate, error rate, duration",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Submit latency (p50 / p95 / p99)",
      "description": "trading_submit_duration_seconds histogram. Budget: ~4ms p50, ~25ms p99 (ARCHITECTURE.md §4.4).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(trading_submit_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(trading_submit_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(trading_submit_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 4,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.004 },
              { "color": "red", "value": 0.025 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Orders/sec by status",
      "description": "sum(rate(trading_orders_total[1m])) by (status)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(trading_orders_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Fills/sec",
      "description": "rate(trading_fills_total[1m])",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 17 },
      "targets": [
        {
          "expr": "rate(trading_fills_total[1m])",
          "legendFormat": "fills/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Rejections & cancels",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Rejections by reason",
      "description": "sum(rate(trading_rejections_total[1m])) by (reason). NOTE: COLLAR_BREACH and NO_REFERENCE_PRICE are risk controls firing correctly — the system rejecting an order it should reject — not faults. Rising counts on those two reasons are not, by themselves, cause for alarm.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "expr": "sum(rate(trading_rejections_total[1m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Cancels by outcome",
      "description": "sum(rate(trading_cancels_total[1m])) by (status). A cancel that finds the order already FILLED lost the race, which is a normal outcome (ARCHITECTURE.md §5.6), not an error.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        {
          "expr": "sum(rate(trading_cancels_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Diagnostics — which check, which symbol",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Invariant violations by check",
      "description": "trading_invariant_violations{check=...}. Breaks down the top-row total so a chaos run shows which check fired: unbalanced_txns, orphaned_fill_halves, unpaired_clearing_units, cash_conservation_delta, position_ledger_mismatch, balance_ledger_mismatch, negative_cash_accounts, overdrawn_reservations.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        {
          "expr": "trading_invariant_violations",
          "legendFormat": "{{check}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Share conservation delta by symbol",
      "description": "trading_share_conservation_delta{symbol=...}. Must be zero for every symbol.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [
        {
          "expr": "trading_share_conservation_delta",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1e-9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
}
